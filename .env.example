# Optional override for Google Analytics 4 measurement ID
NUXT_PUBLIC_GA_MEASUREMENT_ID=G-24DBCT825P

# HTML-tag verification from Google Search Console (required at build time)
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Sanity (publishable — used at build and runtime)
NUXT_PUBLIC_SANITY_PROJECT_ID=s0w6jpzs
NUXT_PUBLIC_SANITY_DATASET=production

# Resend contact form (server-only).
# The sender must be a different address from CONTACT_TO_EMAIL: chsantana.com
# receives through Cloudflare Email Routing, which forwards rather than stores,
# and a forwarder drops mail addressed to the address it was sent from.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=""
