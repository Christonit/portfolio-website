{
  "name": "portfolio",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prebuild": "npm run sync:sanity",
    "build": "nuxt build",
    "predev": "npm run sync:sanity",
    "dev": "nuxt dev",
    "pregenerate": "npm run sync:sanity",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts && npm run check:typography && npm run check:tokens && npm run check:icons && npm run typecheck",
    "test:e2e": "npm run sync:sanity && playwright test",
    "test:e2e:ui": "npm run sync:sanity && playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check:typography": "node scripts/typography-audit.mjs",
    "check:tokens": "node scripts/design-tokens-audit.mjs",
    "check:icons": "node scripts/icon-coverage.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "vue-tsc --noEmit",
    "fonts:icons": "node scripts/fetch-icon-font.mjs",
    "sync:sanity": "node --experimental-strip-types scripts/sync-sanity.ts",
    "studio": "npm run dev --prefix studio-personal-web"
  },
  "dependencies": {
    "@nuxtjs/robots": "^6.2.0",
    "@nuxtjs/sanity": "^2.5.0",
    "@nuxtjs/sitemap": "^8.5.0",
    "groq": "^6.13.1",
    "nuxt": "^3.15.0",
    "nuxt-schema-org": "^6.3.0",
    "three": "^0.184.0",
    "vue": "^3.5.0",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@nuxtjs/color-mode": "^3.5.0",
    "@nuxtjs/tailwindcss": "^6.12.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.184.1",
    "@vueuse/core": "^11.0.0",
    "agentation-vue": "^0.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vue-tsc": "^2.0.0"
  }
}
